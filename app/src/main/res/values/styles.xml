<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        ═══ Kyōkan Design Identity Styles ═══
        Art Direction Brief: "Neon rain on dark water"
        Typography: Cormorant Garamond (display) + Outfit (body) + JetBrains Mono (data)
        Note: Until custom fonts are bundled, sans-serif-light serves as display fallback
              and sans-serif as body fallback. The letterSpacing and textSize values from
              the Brief are applied regardless — they improve hierarchy immediately.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <!-- Brief §BUTTONS: Switches use accent rose when checked -->
        <item name="switchStyle">@style/KyokanSwitch</item>
    </style>

    <!-- Switch — accent thumb/track when on -->
    <style name="KyokanSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

    <!-- ═══ TYPOGRAPHY (Brief §TYPOGRAPHY) ═══ -->

    <!-- Section labels: ALL-CAPS, tracked, 9sp — the app's structural voice -->
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/text_section_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <!-- ═══ NAVIGATION ═══ -->
    <style name="NavTab">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="NavTabLabel">
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/nav_inactive</item>
    </style>

    <!-- ═══ BUTTONS (Brief §BUTTONS) ═══ -->

    <!-- Primary: accent-tinted surface, accent text, rounded 8dp -->
    <style name="KyokanButton">
        <item name="android:backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>
    <!-- Danger: error-tinted surface -->
    <style name="KyokanButton.Danger">
        <item name="android:backgroundTint">@color/btn_red_bg</item>
        <item name="android:textColor">@color/accent_red</item>
    </style>
    <!-- Accent: filled primary -->
    <style name="KyokanButton.Accent">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
    </style>

    <!-- ═══ FILTER CHIPS (Brief §SHAPE — pill radius) ═══ -->
    <style name="KyokanFilterChip">
        <item name="android:textSize">11sp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- ═══ PAGE TITLES (Brief §TYPOGRAPHY — display treatment) ═══ -->

    <!-- Display title — large serif (or serif-fallback), light weight, tracked -->
    <!-- Used for the app name on the home screen -->
    <style name="DisplayTitle">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Page title — used for Voices, Apps, Rules screen headers -->
    <style name="PageTitle">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:layout_marginBottom">@dimen/spacing_lg</item>
    </style>

    <!-- Subtitle under the display title -->
    <style name="DisplaySubtitle">
        <item name="android:textSize">@dimen/text_micro</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
</resources>
